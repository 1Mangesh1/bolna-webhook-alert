SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
WEBHOOK_TOKEN=change-me-to-a-long-random-string
PORT=3000

# Bolna sends webhooks from 13.203.39.153 (https://www.bolna.ai/docs/polling-call-status-webhooks).
# Comma-separated; add more IPs without redeploying. Leave unset for local dev.
# BOLNA_WEBHOOK_IPS=13.203.39.153

# Persist the dedup set across restarts. Recommended in prod so a redeploy
# doesn't re-fire alerts that arrived just before the restart.
# DEDUP_FILE=./data/dedup.json

# Slack section blocks max out around 3000 chars. Override if Slack changes the cap.
# TRANSCRIPT_LIMIT=2800
